/* ============================================================
   UV OIL LEAK DETECTION — Dark Industrial IoT Theme
   ============================================================ */

QMainWindow, QWidget {
    background-color: #0a0a14;
    color: #ccddee;
    font-family: "Segoe UI", "Consolas", monospace;
    font-size: 13px;
}

/* ---- Group Boxes ---- */
QGroupBox {
    border: 1px solid #1e3a5f;
    border-radius: 8px;
    margin-top: 16px;
    padding: 8px 6px 6px 6px;
    background-color: #0d0d20;
    color: #00c8ff;
    font-weight: bold;
    font-size: 12px;
    letter-spacing: 1px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 10px;
    background-color: #0a0a14;
    color: #00c8ff;
    border: 1px solid #1e3a5f;
    border-radius: 4px;
}

/* ---- Labels ---- */
QLabel {
    color: #aabbcc;
    font-size: 12px;
}
QLabel#status_ok {
    color: #00ff88;
    font-size: 22px;
    font-weight: bold;
    letter-spacing: 2px;
}
QLabel#status_nok {
    color: #ff3333;
    font-size: 22px;
    font-weight: bold;
    letter-spacing: 2px;
}
QLabel#status_idle {
    color: #888899;
    font-size: 20px;
    font-weight: bold;
}
QLabel#header_title {
    color: #00c8ff;
    font-size: 20px;
    font-weight: bold;
    letter-spacing: 3px;
}
QLabel#clock_label {
    color: #44aaff;
    font-size: 14px;
    font-family: "Consolas";
}
QLabel#stat_number {
    color: #00c8ff;
    font-size: 26px;
    font-weight: bold;
}
QLabel#stat_label {
    color: #778899;
    font-size: 10px;
    letter-spacing: 1px;
}
QLabel#led_on {
    color: #00ff88;
    font-size: 20px;
}
QLabel#led_off {
    color: #ff3333;
    font-size: 20px;
}

/* ---- Line Edits ---- */
QLineEdit {
    background-color: #111125;
    border: 1px solid #2a4a6f;
    border-radius: 5px;
    padding: 6px 10px;
    color: #ddeeff;
    font-size: 13px;
    selection-background-color: #00558a;
}
QLineEdit:focus {
    border: 1px solid #00c8ff;
    background-color: #131328;
}

/* ---- Buttons ---- */
QPushButton {
    background-color: #112233;
    color: #00c8ff;
    border: 1px solid #00557a;
    border-radius: 6px;
    padding: 8px 18px;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1px;
}
QPushButton:hover {
    background-color: #003355;
    border-color: #00c8ff;
    color: #ffffff;
}
QPushButton:pressed {
    background-color: #001122;
}
QPushButton:disabled {
    background-color: #0d0d18;
    color: #334455;
    border-color: #223344;
}

QPushButton#btn_start {
    background-color: #003322;
    color: #00ff88;
    border-color: #00aa55;
    font-size: 13px;
    padding: 10px 20px;
}
QPushButton#btn_start:hover {
    background-color: #004433;
    border-color: #00ff88;
}
QPushButton#btn_stop {
    background-color: #2a0000;
    color: #ff4444;
    border-color: #aa2222;
    font-size: 13px;
    padding: 10px 20px;
}
QPushButton#btn_stop:hover {
    background-color: #440000;
    border-color: #ff4444;
}
QPushButton#btn_report {
    background-color: #1a1000;
    color: #ffaa00;
    border-color: #886600;
    font-size: 12px;
}
QPushButton#btn_report:hover {
    background-color: #2a1800;
    border-color: #ffaa00;
}

/* ---- Table ---- */
QTableWidget {
    background-color: #0d0d1a;
    alternate-background-color: #111122;
    color: #aabbcc;
    border: 1px solid #1e3a5f;
    gridline-color: #1a2a3a;
    font-size: 11px;
    border-radius: 4px;
}
QTableWidget::item:selected {
    background-color: #003355;
    color: #ffffff;
}
QHeaderView::section {
    background-color: #0a1525;
    color: #00c8ff;
    border: 1px solid #1e3a5f;
    padding: 5px;
    font-weight: bold;
    font-size: 11px;
    letter-spacing: 1px;
}

/* ---- Progress Bar ---- */
QProgressBar {
    background-color: #111122;
    border: 1px solid #1e3a5f;
    border-radius: 5px;
    text-align: center;
    color: #ffffff;
    font-size: 11px;
    height: 18px;
}
QProgressBar::chunk {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #006633,
        stop:1 #00ff88
    );
    border-radius: 4px;
}

/* ---- Scroll Bars ---- */
QScrollBar:vertical {
    background: #0d0d1a;
    width: 10px;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    background: #1e3a5f;
    border-radius: 5px;
    min-height: 20px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

/* ---- Status Bar ---- */
QStatusBar {
    background-color: #080810;
    color: #557799;
    font-size: 11px;
    border-top: 1px solid #1e3a5f;
}

/* ---- Tooltips ---- */
QToolTip {
    background-color: #0a1525;
    color: #00c8ff;
    border: 1px solid #00558a;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 11px;
}

/* ---- Splitter ---- */
QSplitter::handle {
    background-color: #1e3a5f;
}
